# =============================================================================
# Dev environment - Supabase Cloud (dedicated non-production project)
# =============================================================================
TARGET_ENV=dev

# --- Topology -----------------------------------------------------------------
APPS_MODE=local
SUPABASE_MODE=docker

# --- Container identity (unused in dev, kept for parity) ----------------------
SITE_PROD_CONTAINER_NAME=libra-dev
SITE_PROD_IMAGE_NAME=libra-dev

# --- App origins ---------------------------------------------------------------
HOST_PORT=5050
APP_INTERNAL_ORIGIN=http://localhost:8088

# --- Supabase (local, this project only) ---------------------------------------
# Runs on its own base port so it never collides with another project's local
# Supabase. `pnpm supabase:start` generates supabase/config.toml from
# SUPABASE_PORT, so every service lands on 5433x rather than the CLI default
# 5432x. Started as project "libra-dev"; `docker ps` shows *_libra-dev.
#
# The cloud dev project these used to point at (DEV_SUPABASE_* in .secrets) no
# longer exists -- see docs/production-status.md. Those secrets are left in
# place but are no longer read here.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54331
SUPABASE_URL_INTERNAL=http://host.docker.internal:54331
# Standard Supabase local keys: signed with the demo JWT secret below, issued by
# "supabase-demo", and published in Supabase's own docs. Not secrets.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

SUPABASE_PORT=54331
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
SUPABASE_DB_PASSWORD=postgres

# --- Auth ----------------------------------------------------------------------
AUTH_PROVIDER_MODE=supabase

# --- Cross-app navigation ------------------------------------------------------
NEXT_PUBLIC_AUTH_URL=http://localhost:5000
NEXT_PUBLIC_AUTH_HOST_URL=http://localhost:5000
NEXT_PUBLIC_STORE_URL=http://localhost:5001
NEXT_PUBLIC_ADMIN_URL=http://localhost:5002
NEXT_PUBLIC_LANDING_URL=http://localhost:5004
NEXT_PUBLIC_PAYMENTS_URL=http://localhost:5005
NEXT_PUBLIC_STUDIO_URL=http://localhost:5006

# --- OAuth providers -----------------------------------------------------------
SUPABASE_AUTH_SITE_URL=http://localhost:5000/auth/callback

# --- Clerk (third-party auth provider trusted by Supabase) ---------------------
SUPABASE_CLERK_ENABLED=true
SUPABASE_CLERK_DOMAIN=regular-puma-47.clerk.accounts.dev

# --- Clerk (Next.js SDK — sign-in UI in the auth app) ---------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=$secret:CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=$secret:CLERK_SECRET_KEY
NEXT_PUBLIC_CLERK_DOMAIN=$secret:CLERK_DOMAIN

# --- Build flags ---------------------------------------------------------------
NEXT_PUBLIC_ENABLE_TEST_IDS=true
NEXT_PUBLIC_BUILD_HASH=local

# --- Tally feedback widget -----------------------------------------------------
NEXT_PUBLIC_TALLY_FORM_ID=$secret:TALLY_FORM_ID
ENV_DEBUG=true

# --- Cloudflare tunnels --------------------------------------------------------
CLOUDFLARE_TUNNEL_APP_ENABLED=false
CLOUDFLARE_TUNNEL_APP_TOKEN=

# --- E2E test account ----------------------------------------------------------
GOOGLE_TEST_EMAIL=$secret:GOOGLE_TEST_EMAIL
GOOGLE_TEST_PASSWORD=$secret:GOOGLE_TEST_PASSWORD

# --- Sentry error tracking -----------------------------------------------------
# Sentry is not in use. These are empty rather than $secret: references:
# an unresolvable reference makes load-env throw, which broke every local
# Docker build (pre-push gate included). An empty DSN disables the SDK.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=furry-colombia
SENTRY_PROJECT=libra
NEXT_PUBLIC_TARGET_ENV=dev
