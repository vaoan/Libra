# =============================================================================
# Production environment — Next.js in Docker, Supabase Cloud
# =============================================================================
TARGET_ENV=prod

# ─── Topology ─────────────────────────────────────────────────────
APPS_MODE=docker
SUPABASE_MODE=cloud

# ─── Container identity ───────────────────────────────────────────
SITE_PROD_CONTAINER_NAME=libra-prod
SITE_PROD_IMAGE_NAME=libra-prod
HOST_PORT=9090

# ─── App origins ──────────────────────────────────────────────────
APP_INTERNAL_ORIGIN=http://libra-prod:8080

# ─── Supabase Cloud ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://olafyajipvsltohagiah.supabase.co
SUPABASE_URL_INTERNAL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=$secret:PROD_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=$secret:PROD_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_PORT=N/A
SUPABASE_JWT_SECRET=
SUPABASE_DB_PASSWORD=

# ─── Auth ─────────────────────────────────────────────────────────
AUTH_PROVIDER_MODE=supabase

# ─── Cross-app navigation ─────────────────────────────────────────
NEXT_PUBLIC_AUTH_URL=https://store.furrycolombia.com/auth
NEXT_PUBLIC_AUTH_HOST_URL=https://store.furrycolombia.com/auth
NEXT_PUBLIC_STORE_URL=https://store.furrycolombia.com/store
NEXT_PUBLIC_ADMIN_URL=https://store.furrycolombia.com/admin
NEXT_PUBLIC_LANDING_URL=https://store.furrycolombia.com
NEXT_PUBLIC_PAYMENTS_URL=https://store.furrycolombia.com/payments
NEXT_PUBLIC_STUDIO_URL=https://store.furrycolombia.com/studio

# ─── OAuth providers ──────────────────────────────────────────────
SUPABASE_AUTH_SITE_URL=https://store.furrycolombia.com/auth/callback

# ─── Clerk (third-party auth provider trusted by Supabase) ─────────
SUPABASE_CLERK_ENABLED=true
SUPABASE_CLERK_DOMAIN=regular-puma-47.clerk.accounts.dev

# --- Clerk (Next.js SDK — sign-in UI in the auth app) ---------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=$secret:CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=$secret:CLERK_SECRET_KEY
NEXT_PUBLIC_CLERK_DOMAIN=$secret:CLERK_DOMAIN

# ─── Build flags ──────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_TEST_IDS=false
NEXT_PUBLIC_BUILD_HASH=prod

# ─── Tally feedback widget ────────────────────────────────────────
NEXT_PUBLIC_TALLY_FORM_ID=$secret:TALLY_FORM_ID
ENV_DEBUG=false

# ─── Cloudflare tunnels ───────────────────────────────────────────
CLOUDFLARE_TUNNEL_APP_ENABLED=false
CLOUDFLARE_TUNNEL_APP_TOKEN=

# ─── E2E test account ─────────────────────────────────────────────
GOOGLE_TEST_EMAIL=$secret:GOOGLE_TEST_EMAIL
GOOGLE_TEST_PASSWORD=$secret:GOOGLE_TEST_PASSWORD

# ─── Sentry error tracking ────────────────────────────────────────
# Sentry is not in use. These are empty rather than $secret: references:
# an unresolvable reference makes load-env throw, which broke every local
# Docker build (pre-push gate included). An empty DSN disables the SDK.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=furry-colombia
SENTRY_PROJECT=libra
NEXT_PUBLIC_TARGET_ENV=production
