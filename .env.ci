# =============================================================================
# CI environment — Docker app + Docker Supabase, no tunnel
# Topology mirrors staging but uses localhost instead of Cloudflare tunnels,
# and uses different ports (app: 5050, supabase: 54321) to avoid conflicts.
# =============================================================================
TARGET_ENV=ci

# ─── Topology ─────────────────────────────────────────────────────
APPS_MODE=docker
SUPABASE_MODE=docker

# ─── Container identity ───────────────────────────────────────────
SITE_PROD_CONTAINER_NAME=libra-ci
SITE_PROD_IMAGE_NAME=libra-ci
HOST_PORT=5050

# ─── App origins ──────────────────────────────────────────────────
APP_INTERNAL_ORIGIN=http://libra-ci:8080

# ─── Supabase Docker (local, port 54321 — different from staging's 64321) ─────
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
SUPABASE_URL_INTERNAL=http://host.docker.internal:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=$secret:CI_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=$secret:CI_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=$secret:CI_SUPABASE_JWT_SECRET
SUPABASE_DB_PASSWORD=$secret:CI_SUPABASE_DB_PASSWORD
SUPABASE_PORT=54321

# ─── Auth ─────────────────────────────────────────────────────────
AUTH_PROVIDER_MODE=supabase

# ─── Cross-app navigation ─────────────────────────────────────────
NEXT_PUBLIC_AUTH_URL=http://localhost:5050/auth
NEXT_PUBLIC_AUTH_HOST_URL=http://localhost:5050/auth
NEXT_PUBLIC_STORE_URL=http://localhost:5050/store
NEXT_PUBLIC_ADMIN_URL=http://localhost:5050/admin
NEXT_PUBLIC_LANDING_URL=http://localhost:5050
NEXT_PUBLIC_PAYMENTS_URL=http://localhost:5050/payments
NEXT_PUBLIC_STUDIO_URL=http://localhost:5050/studio

# ─── OAuth providers ──────────────────────────────────────────────
SUPABASE_AUTH_SITE_URL=http://localhost:5050/auth/callback

# ─── Clerk (third-party auth provider trusted by Supabase) ─────────
SUPABASE_CLERK_ENABLED=true
SUPABASE_CLERK_DOMAIN=regular-puma-47.clerk.accounts.dev

# --- Clerk (Next.js SDK — sign-in UI in the auth app) ---------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=$secret:CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=$secret:CLERK_SECRET_KEY
NEXT_PUBLIC_CLERK_DOMAIN=$secret:CLERK_DOMAIN

# ─── Build flags ──────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_TEST_IDS=true
NEXT_PUBLIC_BUILD_HASH=ci

# ─── Tally feedback widget ────────────────────────────────────────
NEXT_PUBLIC_TALLY_FORM_ID=$secret:TALLY_FORM_ID
ENV_DEBUG=false

# ─── Cloudflare tunnels ───────────────────────────────────────────
CLOUDFLARE_TUNNEL_APP_ENABLED=false
CLOUDFLARE_TUNNEL_APP_TOKEN=

# ─── E2E test account ─────────────────────────────────────────────
GOOGLE_TEST_EMAIL=$secret:GOOGLE_TEST_EMAIL
GOOGLE_TEST_PASSWORD=$secret:GOOGLE_TEST_PASSWORD

# ─── Sentry error tracking ────────────────────────────────────────
# Sentry is not in use. These are empty rather than $secret: references:
# an unresolvable reference makes load-env throw, which broke every local
# Docker build (pre-push gate included). An empty DSN disables the SDK.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=furry-colombia
SENTRY_PROJECT=libra
NEXT_PUBLIC_TARGET_ENV=ci
