# =============================================================================
# Staging environment — full Docker stack + Cloudflare tunnel
# =============================================================================
TARGET_ENV=staging

# ─── Topology ─────────────────────────────────────────────────────
APPS_MODE=docker
SUPABASE_MODE=docker

# ─── Container identity ───────────────────────────────────────────
SITE_PROD_CONTAINER_NAME=libra-staging
SITE_PROD_IMAGE_NAME=libra-staging
HOST_PORT=7542

# ─── App origins ──────────────────────────────────────────────────
APP_INTERNAL_ORIGIN=http://libra-staging:8080

# ─── Supabase ─────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://supabase.ffxivbe.org
SUPABASE_URL_INTERNAL=http://host.docker.internal:64321
NEXT_PUBLIC_SUPABASE_ANON_KEY=$secret:STAGING_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=$secret:STAGING_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=$secret:STAGING_JWT_SECRET
SUPABASE_DB_PASSWORD=$secret:STAGING_POSTGRES_PASSWORD
SUPABASE_PORT=64321

# ─── Auth ─────────────────────────────────────────────────────────
AUTH_PROVIDER_MODE=supabase

# ─── Cross-app navigation ─────────────────────────────────────────
NEXT_PUBLIC_AUTH_URL=https://store.ffxivbe.org/auth
NEXT_PUBLIC_AUTH_HOST_URL=https://store.ffxivbe.org/auth
NEXT_PUBLIC_STORE_URL=https://store.ffxivbe.org/store
NEXT_PUBLIC_ADMIN_URL=https://store.ffxivbe.org/admin
NEXT_PUBLIC_LANDING_URL=https://store.ffxivbe.org
NEXT_PUBLIC_PAYMENTS_URL=https://store.ffxivbe.org/payments
NEXT_PUBLIC_STUDIO_URL=https://store.ffxivbe.org/studio

# ─── OAuth providers ──────────────────────────────────────────────
SUPABASE_AUTH_SITE_URL=https://store.ffxivbe.org/auth/callback

# ─── Clerk (third-party auth provider trusted by Supabase) ─────────
SUPABASE_CLERK_ENABLED=true
SUPABASE_CLERK_DOMAIN=regular-puma-47.clerk.accounts.dev

# --- Clerk (Next.js SDK — sign-in UI in the auth app) ---------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=$secret:CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=$secret:CLERK_SECRET_KEY
NEXT_PUBLIC_CLERK_DOMAIN=$secret:CLERK_DOMAIN

# ─── Build flags ──────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_TEST_IDS=true
NEXT_PUBLIC_BUILD_HASH=staging

# ─── Tally feedback widget ────────────────────────────────────────
NEXT_PUBLIC_TALLY_FORM_ID=$secret:TALLY_FORM_ID
ENV_DEBUG=true

# ─── Cloudflare tunnels ───────────────────────────────────────────
CLOUDFLARE_TUNNEL_ID=c552cb9c-62bd-4c8b-9ec6-16627b1b8af3
CLOUDFLARE_TUNNEL_APP_ENABLED=true
CLOUDFLARE_TUNNEL_APP_TOKEN=$secret:STAGING_CLOUDFLARE_TUNNEL_APP_TOKEN

CLOUDFLARE_TUNNEL_SUPABASE_ENABLED=false
CLOUDFLARE_TUNNEL_SUPABASE_TOKEN=

# ─── E2E test account ─────────────────────────────────────────────
GOOGLE_TEST_EMAIL=$secret:GOOGLE_TEST_EMAIL
GOOGLE_TEST_PASSWORD=$secret:GOOGLE_TEST_PASSWORD

# ─── Sentry error tracking ────────────────────────────────────────
# Sentry is not in use. These are empty rather than $secret: references:
# an unresolvable reference makes load-env throw, which broke every local
# Docker build (pre-push gate included). An empty DSN disables the SDK.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=furry-colombia
SENTRY_PROJECT=libra
NEXT_PUBLIC_TARGET_ENV=staging
