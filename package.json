{
  "name": "libra",
  "version": "2026.04.22.2",
  "private": true,
  "scripts": {
    "dev": "node scripts/start.mjs",
    "dev:test": "node scripts/start.mjs --env test",
    "build": "node scripts/build.mjs",
    "tunnel": "node scripts/cloudflared.mjs",
    "tunnel:stop": "node scripts/cloudflared-stop.mjs",
    "tunnel:switch": "node scripts/tunnel-switch.mjs",
    "lint:env": "node scripts/check-env-parity.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:watch": "vitest",
    "test:coverage": "turbo test:coverage",
    "test:workflows": "vitest run -c vitest.config.scripts.js",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,css,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,css,md,yml,yaml}\"",
    "fix:staged": "lint-staged --concurrent false",
    "fix:all": "pnpm format && pnpm lint --fix",
    "check:style": "stylelint \"apps/*/src/**/*.css\" \"packages/*/src/**/*.css\" && node scripts/check-css-sync.mjs",
    "check:tools": "pnpm cspell \"apps/*/src/**/*.{ts,tsx,js,jsx,md}\" \"packages/*/src/**/*.{ts,tsx}\" && pnpm knip && pnpm jscpd apps/store/src apps/studio/src apps/landing/src apps/payments/src apps/admin/src apps/auth/src packages/ui/src packages/shared/src packages/api/src packages/app-components/src packages/auth/src && pnpm ls-lint && pnpm madge --circular --extensions ts,tsx,js,jsx apps/store/src apps/studio/src apps/landing/src apps/payments/src apps/admin/src apps/auth/src packages/ui/src packages/shared/src packages/api/src packages/app-components/src packages/auth/src && pnpm sherif && pnpm syncpack lint",
    "sherif": "sherif",
    "sherif:fix": "sherif --fix",
    "syncpack:lint": "syncpack lint",
    "syncpack:fix": "syncpack fix",
    "secretlint": "secretlint \"**/*\"",
    "semgrep": "semgrep scan --config p/ci --config p/security-audit --config p/owasp-top-ten",
    "precommit": "pnpm lint-staged && pnpm lint:env && pnpm lint && pnpm check:style && pnpm check:tools",
    "prepush": "pnpm typecheck && pnpm test:coverage && pnpm build",
    "codegen": "orval --config orval.config.ts",
    "codegen:supabase": "supabase gen types typescript --local > packages/api/src/supabase/types.ts && node -e \"const f=require('fs');const c=f.readFileSync('packages/api/src/supabase/types.ts','utf8');f.writeFileSync('packages/api/src/supabase/types.ts',c.replace(/^Connecting to db \\d+\\n/,''))\"",
    "codegen:all": "pnpm codegen && pnpm codegen:supabase",
    "user:grant-role": "node scripts/grant-user-role.mjs",
    "user:grant-admin": "node scripts/grant-user-role.mjs --email furrycolombia@gmail.com --role admin",
    "sync-secrets": "node scripts/sync-secrets.mjs",
    "provision:account": "node scripts/provision-account.mjs",
    "e2e:dev": "node scripts/e2e.mjs --env dev",
    "e2e:dev:headed": "node scripts/e2e.mjs --env dev --headed",
    "e2e:staging": "node scripts/e2e.mjs --env staging",
    "e2e:staging:headed": "node scripts/e2e.mjs --env staging --headed",
    "e2e:ci": "node scripts/e2e.mjs --env ci",
    "e2e:ci:headed": "node scripts/e2e.mjs --env ci --headed",
    "docker:build": "node scripts/docker-build.mjs",
    "docker:teardown": "node scripts/docker-teardown.mjs",
    "supabase:docker": "node scripts/supabase-docker.mjs",
    "backup:prod": "node scripts/backup-prod.mjs",
    "supabase:start": "docker rm -f supabase_vector_libra 2>nul & node scripts/supabase-cmd.mjs start",
    "supabase:stop": "node scripts/supabase-cmd.mjs stop",
    "supabase:reset": "node scripts/supabase-cmd.mjs db reset",
    "prepare": "husky",
    "clean:builds": "find . -not -path '*/node_modules/*' -not -path '*/.git/*' \\( -name '.next' -o -name '.turbo' -o -name 'test-results' -o -name 'playwright-report' -o -name 'coverage' \\) -type d -prune -exec rm -rf '{}' + ; find . -not -path '*/node_modules/*' -not -path '*/.git/*' \\( -name 'tsconfig.tsbuildinfo' -o -name 'next-env.d.ts' \\) -delete",
    "clean": "pnpm clean:builds && find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "test:db": "node scripts/test-db.mjs",
    "test:inventory": "node scripts/test-inventory.mjs",
    "test:inventory:diff": "bash scripts/test-inventory-diff.sh",
    "check:migrations": "node scripts/check-migration-edits.mjs",
    "check:source-bytes": "node scripts/check-source-bytes.mjs",
    "check:a11y-patterns": "node scripts/check-a11y-patterns.mjs",
    "check:boundaries": "node scripts/check-feature-boundaries.mjs",
    "check:doc-refs": "node scripts/check-doc-references.mjs",
    "check:docs": "node scripts/check-doc-freshness.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ls-lint/ls-lint": "^2.3.1",
    "@playwright/test": "^1.59.1",
    "@secretlint/secretlint-rule-preset-recommend": "^12.3.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/eslint-plugin-query": "^5.100.5",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitest/eslint-plugin": "^1.6.16",
    "cspell": "^10.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.4",
    "eslint-plugin-better-tailwindcss": "^4.4.1",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-i18next": "^6.1.4",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^64.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fast-check": "^4.7.0",
    "husky": "^9.1.7",
    "jscpd": "^4.0.9",
    "knip": "^6.7.0",
    "lint-staged": "^16.4.0",
    "madge": "^8.0.0",
    "orval": "^8.9.0",
    "pg": "^8.23.0",
    "prettier": "^3.8.3",
    "secretlint": "^12.3.1",
    "sharp": "^0.34.5",
    "sherif": "^1.11.1",
    "ssh2": "^1.17.0",
    "stylelint": "^17.9.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "supabase": "^2.95.5",
    "syncpack": "^14.3.1",
    "tailwindcss": "^4.2.4",
    "turbo": "^2.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --check",
      "eslint --max-warnings=0 --no-warn-ignored",
      "secretlint"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --check"
    ]
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
  "msw": {
    "workerDirectory": [
      "apps\\store\\public",
      "apps\\payments\\public",
      "apps\\admin\\public"
    ]
  }
}
